---
import { eq } from "drizzle-orm";
import { db, dbReady, ShortUrl } from "@/db";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import BackLink from "@/components/BackLink.astro";

var url: string | undefined;

try {
    const id = Number(Astro.params.id);
    if (Number.isInteger(id)) {
        await dbReady();
        const query = await db
            .select()
            .from(ShortUrl)
            .where(eq(ShortUrl.id, id));
        url = query[0]?.url;
    }
} catch (e) {
    console.error(e);
}

if (!url) Astro.response.status = 404;

const pageTitle = url ? `Redirecting to ${url} ✨` : "Gnomed into the void";
---

{
    url && (
        <script define:vars={{ url }} is:inline>
            const audio = new Audio("/woo.mp3");
            let leaving = false;

            function go() {
                if (leaving) return;
                leaving = true;
                location.assign(url);
            }

            // The clip is ~0.3s, so leaving once it ends is imperceptible.
            audio.addEventListener("ended", go);

            // Browsers refuse unmuted audio until the visitor interacts with
            // the page, so this rejects on most cold loads. Redirect anyway
            // rather than stranding anyone, but treat the first gesture we do
            // get as permission to let the gnome sing.
            audio.play().catch(() => {
                const fallback = setTimeout(go, 1500);
                for (const event of ["pointerdown", "keydown", "touchend"]) {
                    document.addEventListener(
                        event,
                        () => {
                            clearTimeout(fallback);
                            audio.play().catch(go);
                        },
                        { once: true },
                    );
                }
            });
        </script>
    )
}

<Layout title={pageTitle}>
    <Card class="center">
        <main>
            {
                url ? (
                    <>
                        Seems <strong>you were gnomed</strong> on your way to
                        <a href={url}>{url}</a>
                        <br />
                        <br />
                        Taking you there now…
                    </>
                ) : (
                    <>
                        <strong>The gnome ate this one.</strong>
                        <br />
                        <br />
                        There's no link behind that code.
                        <BackLink text="Make a new one" />
                    </>
                )
            }
        </main>
    </Card>

    <style>
        .center {
            padding: 1.5rem 2rem;
            margin: 0 auto;
            text-align: center;
            width: fit-content;
        }
    </style>
</Layout>
