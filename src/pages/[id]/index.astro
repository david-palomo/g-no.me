---
import { eq } from "drizzle-orm";
import { db, dbReady, ShortUrl } from "@/db";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import BackLink from "@/components/BackLink.astro";

var url: string | undefined;

try {
    const id = Number(Astro.params.id);
    if (Number.isInteger(id)) {
        await dbReady();
        const query = await db
            .select()
            .from(ShortUrl)
            .where(eq(ShortUrl.id, id));
        url = query[0]?.url;
    }
} catch (e) {
    console.error(e);
}

if (!url) Astro.response.status = 404;

const pageTitle = url ? `Redirecting to ${url} ✨` : "Gnomed into the void";
---

{
    url && (
        <script define:vars={{ url }} is:inline>
            const LINGER_MS = 5000;

            function start() {
                const counter = document.getElementById("countdown");
                const counterLine = document.getElementById("countdown-line");
                const audio = new Audio("/woo.mp3");
                const deadline = Date.now() + LINGER_MS;
                let leaving = false;
                let ticker;

                function go() {
                    if (leaving) return;
                    leaving = true;
                    clearInterval(ticker);
                    location.assign(url);
                }

                // Derived from a deadline rather than decremented, so a
                // throttled background tab can't strand anyone on a frozen
                // number. Revealing on the first tick also means the counter
                // stays hidden if this script never runs, rather than sitting
                // there stuck.
                function tick() {
                    const left = Math.ceil((deadline - Date.now()) / 1000);
                    if (left <= 0) return go();
                    counterLine.classList.add("ticking");
                    counter.textContent = left;
                }

                tick();
                ticker = setInterval(tick, 250);

                document.addEventListener("visibilitychange", () => {
                    if (document.visibilityState === "visible") tick();
                });

                // Browsers refuse unmuted audio until the visitor interacts
                // with the page, so this rejects on most loads -- the
                // countdown is what gets them out. Where it is allowed the
                // gnome just sings on arrival; it must not cut the countdown
                // short, so nothing is hooked to "ended" here.
                audio.play().catch(() => {});

                // A tap is the gesture that buys us the sound, and it means
                // "let me off", so this one does leave once the clip ends.
                for (const event of ["pointerdown", "keydown"]) {
                    document.addEventListener(
                        event,
                        () => {
                            clearInterval(ticker);
                            audio.addEventListener("ended", go, {
                                once: true,
                            });
                            audio.currentTime = 0;
                            audio.play().catch(go);
                        },
                        { once: true },
                    );
                }
            }

            // Astro emits this inline script above the markup it drives, so
            // the elements do not exist yet when it first runs.
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", start);
            } else {
                start();
            }
        </script>
    )
}

<Layout title={pageTitle}>
    <Card>
        <main>
            {
                url ? (
                    <>
                        <img
                            src="/favicon.svg"
                            alt=""
                            width="120"
                            height="120"
                        />
                        <p class="shout">You've been gnomed!</p>
                        <p class="dest">
                            on your way to <a href={url}>{url}</a>
                        </p>
                        <p class="hint">
                            <strong>Tap anywhere</strong> to get off my property
                        </p>
                        <p class="countdown" id="countdown-line">
                            or I'll shove you off in <span id="countdown">5</span>
                        </p>
                    </>
                ) : (
                    <>
                        <strong>The gnome ate this one.</strong>
                        <br />
                        <br />
                        There's no link behind that code.
                        <BackLink text="Make a new one" />
                    </>
                )
            }
        </main>
    </Card>

    <style>
        /* `<Card class="center">` never worked: Card doesn't forward props, so
           the rule matched nothing. Style the element this page owns instead. */
        main {
            padding: 1.5rem 2rem;
            text-align: center;
        }
        main :global(a) {
            margin-inline: auto;
        }
        .shout {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0.5rem 0 0.25rem;
        }
        .dest {
            margin: 0 0 1.25rem;
        }
        .dest a {
            display: block;
            margin-top: 0.15rem;
            overflow-wrap: anywhere;
        }
        .hint {
            margin: 0;
        }
        .countdown {
            margin: 0.35rem 0 0;
            font-size: 0.75rem;
            opacity: 0.6;
            /* Reserve the space so revealing it doesn't shift the layout.
               Without JS it simply never appears, which is correct: nothing
               is going to count down. */
            visibility: hidden;
        }
        .countdown.ticking {
            visibility: visible;
        }
    </style>
</Layout>
